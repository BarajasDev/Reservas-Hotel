# ------------------------------------------------------------------
# Plantilla de variables de entorno.
#
# Copia este archivo como ".env" antes de levantar el proyecto:
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
#
# El archivo ".env" real NO se sube a GitHub porque lleva contrasenas
# (esta listado en .gitignore).
# ------------------------------------------------------------------

# --- Base de datos PostgreSQL ---
POSTGRES_USER=hotel_user
POSTGRES_PASSWORD=hotel_password
POSTGRES_DB=reservas_hotel

# --- Cadena de conexion que usa SQLAlchemy ---
# El host "db" es el nombre del servicio de PostgreSQL en docker-compose.yml.
DATABASE_URL=postgresql://hotel_user:hotel_password@db:5432/reservas_hotel

# --- Configuracion de la aplicacion ---
APP_TITLE=API Reservas Hotel
